# Скопируйте этот файл в .env и заполните значения.

# Секретный ключ Django. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# True — режим разработки, False — продакшен
DJANGO_DEBUG=True

# Имена хостов и IP-адреса, по которым открывается сайт, через запятую
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Для HTTPS-доступа по домену, например: https://nir.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=
# True — cookies только по HTTPS (включать после настройки HTTPS)
DJANGO_SECURE_COOKIES=False

# База данных: sqlite или postgresql
DB_ENGINE=sqlite
# Для sqlite: путь к файлу (по умолчанию db.sqlite3 в корне проекта)
# Для postgresql: имя базы
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Журнал активности: срок хранения записей в днях (старые удаляет manage.py purge_activity_log)
ACTIVITY_LOG_DAYS=365
# True — IP клиента брать из заголовка X-Real-IP (включать только за Nginx, который этот заголовок задаёт)
ACTIVITY_TRUST_PROXY_HEADER=False
